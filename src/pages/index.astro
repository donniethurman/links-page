---
// Everything between the --- fences runs at build time (or on each request in
// `npm run dev`), never in the visitor's browser. The page ships as plain HTML.

// Keystatic's reader loads content straight from the files in the repo.
import { createReader } from '@keystatic/core/reader';
// The same schema the /keystatic admin uses, so the data read here is typed.
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/Layout.astro';

// process.cwd() is the project root, which is where Keystatic resolves the
// content paths from keystatic.config.ts (e.g. src/content/profile.json).
const reader = createReader(process.cwd(), keystaticConfig);

// Read the Profile singleton. readOrThrow() fails the build if the file is
// missing, instead of quietly rendering an empty page.
const profile = await reader.singletons.profile.readOrThrow();

// The avatar is optional in the admin. Keystatic stores an uploaded image as a
// public path like /images/avatar/me.jpg; when none is set, use a placeholder.
const avatar = profile.avatar ?? 'https://assets.codepen.io/16425/image-placeholder.png';
---

{/* Layout provides <html>, <head> and the styled <body>; the <title> is passed as a prop. */}
<Layout title={`${profile.name} — Links`}>
  {/* A single narrow, centred column that works on phones and wide screens alike. */}

  <div class="star-background" aria-hidden="true"></div>

<!-- Your existing profile and links -->
  <main class="ornament-frame relative z-10 mx-auto max-w-md px-6 py-16 text-center">
    <span class="corner-star star-top-left">✦</span>
    <span class="corner-star star-top-right">✦</span>
    <span class="corner-star star-bottom-left">✦</span>
    <span class="corner-star star-bottom-right">✦</span>
    {/* alt="" marks the avatar as decorative: the name right below already identifies the person. */}
    <div class="flex items-center gap-3">
  <h1 class="font-asimovian text-6xl tracking-wide text-left animated-name">
    {profile.name}
  </h1>

  <div class="relative -rotate-3 translate-y-[-5px] translate-x-[-20px]">
    <img
      src={avatar}
      alt=""
      class="w-47 h-35 object-cover rounded-sm"
    />
  </div>
</div>

  <p class="text-justify whitespace-pre-line leading-relaxed whitespace-pre-line mt-1 text-sm text-neutral-500 dark:text-neutral-400">{profile.bio}</p>
    {/*
      One <li> per link, in the order set in the admin. The shared `.link`
      class (src/styles/global.css) holds the button styles, so they live in
      one place instead of being repeated on every <a>.

      The icon is optional and only rendered when one was uploaded. Its alt=""
      marks it as decorative: the label next to it already names the link.
    */}
    <ul class="mt-8 space-y-3">
      {profile.links.map((link) => (
        <li>
          <a href={link.href} class="link">
            {link.icon && <img src={link.icon} alt="" class="link-icon" />}
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <script>
  const colors = ["#FFECD5", "#E06C9F", "#C0C0C0"];

  document.addEventListener("mousemove", (e) => {
    const sparkle = document.createElement("span");

    sparkle.className = "sparkle";
    sparkle.textContent = "✦";

    sparkle.style.left = `${e.clientX}px`;
    sparkle.style.top = `${e.clientY}px`;
    sparkle.style.color =
      colors[Math.floor(Math.random() * colors.length)];

    document.body.appendChild(sparkle);

    setTimeout(() => {
      sparkle.remove();
    }, 700);
  });
</script>
<script>
  const background = document.querySelector(".star-background");

  if (background) {
    const starCount = 85;

    for (let i = 0; i < starCount; i++) {
      const star = document.createElement("span");

      star.className = "twinkle-star";
      star.textContent = Math.random() > 0.6 ? "✦" : "·";

      star.style.left = `${Math.random() * 100}%`;
      star.style.top = `${Math.random() * 100}%`;

      star.style.fontSize = `${Math.random() * 10 + 5}px`;
      star.style.animationDuration = `${Math.random() * 5 + 3}s`;
      star.style.animationDelay = `${Math.random() * -8}s`;

      background.appendChild(star);
    }
  }
</script>
  </main>
</Layout>
